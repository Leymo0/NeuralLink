{
  "name": "neurallink",
  "productName": "NeuralLink",
  "version": "0.7.3",
  "private": true,
  "description": "Cyberpunk 2077 co-op: one plays, the Operator watches, hacks and talks in his head",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": "Peri",
  "build": {
    "appId": "com.peri.neurallink",
    "productName": "NeuralLink",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!thirdparty/**",
      "!mod/**",
      "!dist/**",
      "!build/icon.ico",
      "!README.md",
      "!.github/**",
      "!build/release-notes.md",
      "!**/*.log",
      "!scripts/**"
    ],
    "extraResources": [
      {
        "from": "mod",
        "to": "mod"
      },
      {
        "from": "thirdparty",
        "to": "thirdparty"
      },
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NeuralLink",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "NeuralLink-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Leymo0",
        "repo": "NeuralLink",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Leymo0/NeuralLink.git"
  }
}